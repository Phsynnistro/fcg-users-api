{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "MassTransit": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss ",
        "UseUtcTimestamp": true,
        "IncludeScopes": true
      }
    }
  },
  "AllowedHosts": "*",
  "ApiDocs": {
    "Enabled": false
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/"
  },
  "Jwt": {
    "Issuer": "fcg-users-api",
    "Audience": "fcg",
    "AccessTokenLifetimeMinutes": 60
  },
  "Seed": {
    "AdminName": "Administrador FCG"
  },
  "RateLimiting": {
    "Authentication": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    }
  }
}
